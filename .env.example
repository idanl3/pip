# Pip — local environment.
# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed. This repository is public.

# --- Safe for the browser -----------------------------------------------
# Anything prefixed VITE_ is bundled into the site and is publicly visible.
# Supabase publishable keys are designed for this; row-level security is what
# protects the data. (This replaces what used to be called the anon key.)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Secrets: never prefixed with VITE_ ---------------------------------
# The database password, read automatically by the Supabase CLI when pushing
# migrations.
SUPABASE_DB_PASSWORD=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_EN=

# Replaces the old service_role key. Only for edge functions that must bypass
# row-level security.
SUPABASE_SECRET_KEY=

# Supabase personal access token, from
# https://supabase.com/dashboard/account/tokens
# Lets the CLI link the project, push migrations and deploy edge functions.
SUPABASE_ACCESS_TOKEN=
