# Pip — local environment.
# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed. The repository is public.

# --- Safe for the browser -----------------------------------------------
# Anything prefixed VITE_ is bundled into the site and is publicly visible.
# The Supabase anon key is designed for this; row-level security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only ---------------------------------------------------
# Never prefix these with VITE_. They live here for local scripts only, and
# are set as Supabase function secrets for production.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_EN=
SUPABASE_SERVICE_ROLE_KEY=
